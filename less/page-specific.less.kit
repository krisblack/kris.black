// Hello Page UL
.areasOfExpertise {
  list-style-type: none;
  padding-left: 0;
  
  li {
    font-size: 1.25rem;
    padding-left: 1.65em;
    text-indent: -1.65em;

    &::after {
      display: none;
    }
    
    &:first-child {
      & > :first-child {
        margin-top: 0;
      }
    }
    
    &::before {
      content: "\2714";
      display: inline;
      font-weight: 400;
      margin-right: 0.4rem;
      text-align: left;
      visibility: visible;
    }
  }
  
  @media only screen and (min-width: 940px) {
    column-gap: 3em;
    display: grid;
  grid-template-columns: repeat(2, 1fr);
    grid-template-rows: repeat(4, 1fr);
    width: fit-content;
    
    li:nth-child(2) {
        grid-column-start: 1;
        grid-row-start: 2;
    }

    li:nth-child(3) {
        grid-column-start: 1;
        grid-row-start: 3;
    }

    li:nth-child(4) {
        grid-column-start: 1;
        grid-row-start: 4;
    }

    li:nth-child(5) {
        grid-column-start: 2;
        grid-row-start: 1;
    }

    li:nth-child(6) {
        grid-column-start: 2;
        grid-row-start: 2;
    }

    li:nth-child(7) {
        grid-column-start: 2;
        grid-row-start: 3;
    }

    li:nth-child(8) {
        grid-row-start: 4;
    }
  }
}

.kb-industries {
  align-items: center;
  background-color: @black;
  //border: 3px solid @black;
  border-radius: 12px;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-around;
  list-style: none;
  padding: 1.25rem;
  
  li {
    align-self: auto;
    border-right: 1px solid #575757;
    color: @white;
    display: block;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: auto;
    font-size: 0.9rem;
    justify-content: center;
    text-align: center;
    width: 49%;
    
    &:last-of-type {
      border-right: none;
    }
  }
  
  @media screen and (max-width: 639.99px) {
    li {
      margin: 0.5rem 0;
      padding: 0.5rem 0;
      position: relative;
    
      &:nth-child(even) {
        border-right: none;
      }
      
      &:nth-child(-n + 4):after {
        background-color: #575757;
        bottom: -0.5rem;
        content: " ";
        display: block;
        height: 1px;
        margin: 0 10%;
        position: absolute;
        width: 80%;
      }
    }

  }
  
  @media screen and (min-width: 640px) {
    flex-wrap: nowrap;
    padding: 1rem;

    li {
      font-size: 1rem;
      width: auto;
    }
  }
  
  @media screen and (min-width: 990px) {
    padding: 2rem;
  
    li {
      font-size: 1.5rem;
    }
  }
}
